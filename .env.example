# ==========================================
# ODONTOSHIELD - CONFIGURAÇÃO DE SEGURANÇA E AMBIENTE
# ==========================================

# 1. Banco de Dados PostgreSQL (NUNCA versione este arquivo com valores reais)
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require"

# 2. Chave Secreta para Assinatura de Sessões e Tokens (Gere uma chave aleatória de 32+ caracteres)
AUTH_SECRET="gere_uma_chave_secreta_longa_e_aleatoria_aqui"

# 3. Integração com Stripe (Pagamentos & Assinaturas)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
